            <script>
                function showMobileMenu() {
                    var x = document.getElementById("myLinks");
                    if (x.style.display === "block") {
                        x.style.display = "none";
                    } else {
                        x.style.display = "block";
                    }
                }
            </script>

        <script>
            // Hamburger Menu Toggle
            function myFunctionburger() {
                var nav = document.getElementById("mynew_topnav");
                var dropdown = document.querySelector('.new_dropdown');

                if (nav.className === "new_topnav") {
                    nav.className += " new_responsive";
                } else {
                    nav.className = "new_topnav";
                    // Close dropdown when closing menu
                    if (dropdown) {
                        dropdown.classList.remove('active');
                    }
                }
            }

            // Dropdown Toggle for Mobile
            function show(event) {
                if (event) {
                    event.preventDefault();
                    event.stopPropagation();
                }

                var dropdown = document.querySelector('.new_dropdown');
                var nav = document.getElementById("mynew_topnav");

                // Only toggle on mobile when menu is open
                if (window.innerWidth <= 600 && nav.classList.contains('new_responsive')) {
                    dropdown.classList.toggle('active');
                }
            }

            // Close dropdown when clicking outside (desktop only)
            document.addEventListener('click', function (event) {
                if (window.innerWidth > 600) {
                    var dropdown = document.querySelector('.new_dropdown');
                    if (dropdown && !dropdown.contains(event.target)) {
                        dropdown.classList.remove('active');
                    }
                }
            });

            // Prevent dropdown from closing when clicking inside it
            document.addEventListener('DOMContentLoaded', function () {
                var dropdownContent = document.querySelector('.new_dropdown-content');
                if (dropdownContent) {
                    dropdownContent.addEventListener('click', function (e) {
                        e.stopPropagation();
                    });
                }
            });

            // Social Media Functions
            function goto_FB() {
                window.open('https://www.facebook.com/gawadkalinga', '_blank');
            }

            function goto_IG() {
                window.open('https://www.instagram.com/gawadkalinga', '_blank');
            }

            function goto_TWTR() {
                window.open('https://twitter.com/gawadkalingahq', '_blank');
            }

            function goto_YT() {
                window.open('https://www.youtube.com/GawadKalingaHQ', '_blank');
            }

            function goto_DT() {
                window.open('https://www.gk1world.org/ccsecuregeneric2.aspx?dcode=gkmission', '_blank');
            }
</script>

            
